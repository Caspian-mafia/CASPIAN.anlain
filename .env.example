# Copy to .env on the VPS only. Never commit the real .env file.
# Use gamefyconnect.net only after confirming the domain is paid/active and DNS points to this VPS.
DOMAIN=your-domain.example
PUBLIC_BASE_URL=https://your-domain.example

# Generate unique random values on the VPS; do not reuse credentials.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CASPIAN_ADMIN_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Keep payments in sandbox until merchant onboarding and callback verification are complete.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# Payment providers: ZarinPal IPG, Asan Pardakht merchant IPG, and manual card transfer.
CASPIAN_PAYMENT_METHODS=zarinpal,asanpardakht,card_to_card

# Asan Pardakht (AP) merchant IPG credentials; fill only after merchant approval.
ASANPARDAKHT_MERCHANT_CONFIGURATION_ID=
ASANPARDAKHT_USERNAME=
ASANPARDAKHT_PASSWORD=

# Manual card-to-card fallback; admin verification is mandatory.
CARD_TO_CARD_ENABLED=true
CARD_TO_CARD_DESTINATION=
CARD_TO_CARD_OWNER=
CARD_TO_CARD_AUTO_APPROVE=false

# Optional SMS OTP credentials.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Optional JSON override for coin package prices in IRR; leave blank for code defaults.
CASPIAN_COIN_PACKAGES=

# Optional WebRTC ICE/TURN configuration. Keep TURN secret private.
CASPIAN_ICE_SERVERS=[]
CASPIAN_TURN_URLS=
CASPIAN_TURN_SECRET=
